<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Optimization: Leathers - C# Edition の既存セーブ互換用。
    新規生成はC#側で禁止し、旧セーブ内のThing/Stuff参照を解決するためだけにDef名を保持する。
  -->

  <StuffCategoryDef>
    <defName>Chitin</defName>
    <label>キチン</label>
  </StuffCategoryDef>

  <ThingDef ParentName="LeatherBase">
    <defName>Leather_Legend</defName>
    <label>伝説級の革</label>
    <description>旧 Optimization: Leathers のセーブ互換用Defです。新規生成されません。</description>
    <statBases>
      <MarketValue>14</MarketValue>
      <StuffPower_Armor_Sharp>2.08</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.36</StuffPower_Armor_Blunt>
      <StuffPower_Insulation_Cold>34</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>22</StuffPower_Insulation_Heat>
    </statBases>
    <stuffProps>
      <allowedInStuffGeneration>false</allowedInStuffGeneration>
      <statFactors>
        <MaxHitPoints>2</MaxHitPoints>
        <Beauty>8</Beauty>
      </statFactors>
    </stuffProps>
  </ThingDef>

  <ThingDef ParentName="LeatherBase">
    <defName>Leather_Chitin</defName>
    <label>キチン</label>
    <description>旧 Optimization: Leathers のセーブ互換用Defです。新規生成されません。</description>
    <statBases>
      <MarketValue>6</MarketValue>
      <Mass>0.55</Mass>
      <StuffPower_Armor_Sharp>0.92</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.18</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.27</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>5</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
    </statBases>
    <stuffProps>
      <allowedInStuffGeneration>false</allowedInStuffGeneration>
      <categories Inherit="False">
        <li>Leathery</li>
        <li>Chitin</li>
      </categories>
    </stuffProps>
  </ThingDef>

  <ThingDef ParentName="LeatherBase">
    <defName>Leather_DragonScale</defName>
    <label>竜鱗</label>
    <description>旧 Optimization: Leathers のセーブ互換用Defです。新規生成されません。</description>
    <statBases>
      <MarketValue>5</MarketValue>
      <Mass>1</Mass>
      <StuffPower_Armor_Sharp>1</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.55</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.35</StuffPower_Armor_Heat>
    </statBases>
    <stuffProps>
      <allowedInStuffGeneration>false</allowedInStuffGeneration>
      <categories Inherit="False">
        <li>Metallic</li>
      </categories>
      <statFactors>
        <MaxHitPoints>3</MaxHitPoints>
        <Flammability>0.2</Flammability>
        <Beauty>1.75</Beauty>
        <WorkToMake>2.5</WorkToMake>
        <WorkToBuild>2.5</WorkToBuild>
        <DoorOpenSpeed>0.75</DoorOpenSpeed>
        <MeleeWeapon_CooldownMultiplier>1.4</MeleeWeapon_CooldownMultiplier>
      </statFactors>
      <statOffsets>
        <Beauty>7</Beauty>
      </statOffsets>
    </stuffProps>
  </ThingDef>
</Defs>
