<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PrivateLeatherConsolidator.LeatherConsolidatorSettingsDef>
    <defName>LeatherConsolidator_DefaultSettings</defName>
    <removeLeatheryCategoryFromMergedLeathers>true</removeLeatheryCategoryFromMergedLeathers>
    <mergeHumanlikeLeathersIntoHuman>true</mergeHumanlikeLeathersIntoHuman>
    <protectExtremeLeathers>true</protectExtremeLeathers>
    <protectMultiCategoryLeathers>true</protectMultiCategoryLeathers>
    <enableThingMakerFallback>true</enableThingMakerFallback>
    <migrateExistingBills>true</migrateExistingBills>
    <migrateExistingRawLeatherStacks>true</migrateExistingRawLeatherStacks>
    <verboseLog>true</verboseLog>
    <alwaysKeep>
      <li>Leather_Human</li>
      <li>Leather_Thrumbo</li>
      <li>Thrumbomane</li>
      <li>Leather_Thrumbomane</li>
    </alwaysKeep>
    <overrides />
  </PrivateLeatherConsolidator.LeatherConsolidatorSettingsDef>
</Defs>
